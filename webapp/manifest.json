{
  "_version": "1.84.0",
  "sap.app": {
    "id": "arrows.cap.cli.clientmanager.web.clientmanagerweb",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/manager-client/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "82cd7224-e442-444c-9c61-437684426674"
    },
    "crossNavigation": {
      "inbounds": {
        "ClientManager-display": {
          "semanticObject": "ClientManager",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.147.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "arrows.cap.cli.clientmanager.web.clientmanagerweb.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "arrows.cap.cli.clientmanager.web.clientmanagerweb.view",
        "async": true,
        "viewPath": "arrows.cap.cli.clientmanager.web.clientmanagerweb.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteClientDetail",
          "pattern": "clients/{clientId}",
          "target": [
            "TargetClientDetail"
          ]
        },
        {
          "name": "RouteProjectDetail",
          "pattern": "clients/{clientId}/projects/{projectId}",
          "target": [
            "TargetProjectDetail"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetClientDetail": {
          "id": "ClientDetail",
          "name": "ClientDetail"
        },
        "TargetProjectDetail": {
          "id": "ProjectDetail",
          "name": "ProjectDetail"
        }
      }
    },
    "rootView": {
      "viewName": "arrows.cap.cli.clientmanager.web.clientmanagerweb.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "clientmanagerweb"
  }
}