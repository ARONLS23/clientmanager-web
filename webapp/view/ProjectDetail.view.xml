<mvc:View
    controllerName="arrows.cap.cli.clientmanager.web.clientmanagerweb.controller.ProjectDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Detalle de proyecto"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <ObjectHeader
                title="{name}"
                number="{code}"
                intro="Proyecto">
                <attributes>
                    <ObjectAttribute title="Descripción" text="{description}" />
                    <ObjectAttribute title="Estado" text="{status}" />
                    <ObjectAttribute title="Fecha inicio" text="{startDate}" />
                    <ObjectAttribute title="Fecha fin" text="{endDate}" />
                </attributes>
            </ObjectHeader>

            <IconTabBar
                class="sapUiResponsiveContentPadding"
                expandable="false">

                <items>
                    <IconTabFilter
                        text="Miembros"
                        key="members"
                        icon="sap-icon://group">

                        <Table
                            id="membersTable"
                            mode="SingleSelectLeft"
                            includeItemInSelection="false"
                            items="{
                                path: '/ProjectMembers',
                                parameters: {
                                    $select: 'ID,role,fullName,email,project_ID'
                                }
                            }">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Miembros del proyecto" />
                                    <ToolbarSpacer />

                                    <Button
                                        text="Nuevo"
                                        type="Emphasized"
                                        press=".onCreateMember" />
                                    <Button
                                        text="Editar"
                                        press=".onEditMember" />
                                    <Button
                                        text="Eliminar"
                                        type="Reject"
                                        press=".onDeleteMember" />
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column>
                                    <Text text="Nombre" />
                                </Column>
                                <Column>
                                    <Text text="Correo" />
                                </Column>
                                <Column>
                                    <Text text="Rol" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{fullName}" />
                                        <Text text="{email}" />
                                        <Text text="{role}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter
                        text="Tareas"
                        key="tasks"
                        icon="sap-icon://task">

                        <Table
                            id="tasksTable"
                            mode="SingleSelectLeft"
                            includeItemInSelection="false"
                            items="{
                                path: '/Tasks',
                                parameters: {
                                    $select: 'ID,title,description,status,priority,dueDate,project_ID,assignee_ID'
                                }
                            }">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Tareas del proyecto" />
                                    <ToolbarSpacer />

                                    <Button
                                        text="Nuevo"
                                        type="Emphasized"
                                        press=".onCreateTask" />
                                    <Button
                                        text="Editar"
                                        press=".onEditTask" />
                                    <Button
                                        text="Eliminar"
                                        type="Reject"
                                        press=".onDeleteTask" />
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column>
                                    <Text text="Título" />
                                </Column>
                                <Column>
                                    <Text text="Estado" />
                                </Column>
                                <Column>
                                    <Text text="Prioridad" />
                                </Column>
                                <Column>
                                    <Text text="Fecha límite" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{title}" />
                                        <Text text="{status}" />
                                        <Text text="{priority}" />
                                        <Text text="{dueDate}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter
                        text="Documentos"
                        key="documents"
                        icon="sap-icon://documents">

                        <Table
                            id="documentsTable"
                            mode="SingleSelectLeft"
                            includeItemInSelection="false"
                            items="{
                                path: '/Documents',
                                parameters: {
                                    $select: 'ID,name,type,description,mediaType,size,project_ID'
                                }
                            }">

                            <headerToolbar>
                                <Toolbar>
                                    <Title text="Documentos del proyecto" />
                                    <ToolbarSpacer />

                                    <Button
                                        text="Nuevo"
                                        type="Emphasized"
                                        press=".onCreateDocument" />
                                    <Button
                                        text="Editar descripción"
                                        press=".onEditDocument" />
                                    <Button
                                        text="Descargar"
                                        press=".onDownloadDocument" />
                                    <Button
                                        text="Eliminar"
                                        type="Reject"
                                        press=".onDeleteDocument" />
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column>
                                    <Text text="Nombre" />
                                </Column>
                                <Column>
                                    <Text text="Tipo" />
                                </Column>
                                <Column>
                                    <Text text="Descripción" />
                                </Column>
                                <Column>
                                    <Text text="Tamaño" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{name}" />
                                        <Text text="{type}" />
                                        <Text text="{description}" />
                                        <Text text="{size}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>

</mvc:View>