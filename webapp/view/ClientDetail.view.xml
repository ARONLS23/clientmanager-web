<mvc:View
    controllerName="arrows.cap.cli.clientmanager.web.clientmanagerweb.controller.ClientDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Detalle de cliente"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>
            <ObjectHeader
                title="{name}"
                number="{code}"
                intro="Cliente">
                <attributes>
                    <ObjectAttribute title="Descripción" text="{description}" />
                    <ObjectAttribute title="Creado por" text="{createdBy}" />
                    <ObjectAttribute title="Modificado por" text="{modifiedBy}" />
                </attributes>
            </ObjectHeader>

            <Panel
                headerText="Proyectos del cliente"
                class="sapUiResponsiveMargin"
                width="auto">

                <Table
                    id="projectsTable"
                    items="{
                        path: '/Projects',
                        parameters: {
                            $select: 'ID,code,name,description,startDate,endDate,status,client_ID'
                        }
                    }"
                    mode="SingleSelectLeft"
                    includeItemInSelection="false">

                    <headerToolbar>
                        <Toolbar>
                            <Title text="Proyectos del cliente" />
                            <ToolbarSpacer />

                            <Button
                                text="Nuevo"
                                type="Emphasized"
                                press=".onCreateProject" />

                            <Button
                                text="Editar"
                                press=".onEditProject" />

                            <Button
                                text="Eliminar"
                                type="Reject"
                                press=".onDeleteProject" />
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column>
                            <Text text="Código" />
                        </Column>
                        <Column>
                            <Text text="Nombre" />
                        </Column>
                        <Column>
                            <Text text="Estado" />
                        </Column>
                        <Column>
                            <Text text="Fecha inicio" />
                        </Column>
                        <Column>
                            <Text text="Fecha fin" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{code}" />
                                <Text text="{name}" />
                                <Text text="{status}" />
                                <Text text="{startDate}" />
                                <Text text="{endDate}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>

</mvc:View>