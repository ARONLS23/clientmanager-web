<mvc:View
    controllerName="arrows.cap.cli.clientmanager.web.clientmanagerweb.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Clientes">
        <content>
            <Table
                id="clientsTable"
                items="{/Clients}"
                mode="SingleSelectLeft"
                includeItemInSelection="false"
                itemPress=".onClientPress">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Lista de clientes" />
                        <ToolbarSpacer />
                        <SearchField
                            width="18rem"
                            placeholder="Buscar cliente"
                            search=".onSearch" />
                        <Button
                            text="Nuevo"
                            type="Emphasized"
                            press=".onCreateClient" />

                        <Button
                            text="Editar"
                            press=".onEditClient" />

                        <Button
                            text="Eliminar"
                            type="Reject"
                            press=".onDeleteClient" />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="Código" />
                    </Column>
                    <Column>
                        <Text text="Nombre" />
                    </Column>
                    <Column>
                        <Text text="Descripción" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{code}" />
                            <Text text="{name}" />
                            <Text text="{description}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>

</mvc:View>