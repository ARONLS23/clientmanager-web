<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="clientDialog"
        title="{dialog>/title}"
        contentWidth="32rem"
        contentHeight="auto">

        <content>
            <VBox
                class="sapUiMediumMargin"
                width="auto">

                <Label text="Código" />
                <Input
                    value="{dialog>/code}"
                    maxLength="20"
                    width="100%"
                    placeholder="Ejemplo: CLI004" />

                <Label text="Nombre" class="sapUiMediumMarginTop" />
                <Input
                    value="{dialog>/name}"
                    maxLength="100"
                    width="100%"
                    placeholder="Nombre del cliente" />

                <Label text="Descripción" class="sapUiMediumMarginTop" />
                <TextArea
                    value="{dialog>/description}"
                    maxLength="255"
                    rows="5"
                    width="100%"
                    placeholder="Descripción del cliente" />
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Guardar"
                type="Emphasized"
                press=".onSaveClient" />
        </beginButton>

        <endButton>
            <Button
                text="Cancelar"
                press=".onCancelClientDialog" />
        </endButton>
    </Dialog>

</core:FragmentDefinition>